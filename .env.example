# Discord Bot Configuration
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Polygon.io (now Massive) API Configuration, needed for stocks like X:AAPL
# Get your API key from: https://massive.com/
POLYGON=your_polygon_api_key_here

# CoinGecko API Configuration (optional: crypto works without a key, with lower rate limits)
# Get a free Demo API key from: https://www.coingecko.com/en/api
# COIN_GECKO=your_coingecko_api_key_here

# Logging level: DEBUG, INFO, WARNING or ERROR (default: INFO)
# LOG_LEVEL=INFO
